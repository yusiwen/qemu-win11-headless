# Reverse proxy in front of the Guacamole gateway, on a different host (ECS),
# with Authelia forward_auth in front of that.
#
#   browser ──HTTPS──▶ ECS nginx ──authelia forward_auth──▶ wireguard ──▶ nuc12
#                        │                                              ├─ Caddy :8443
#                        └─ X-Guac-User: guacadmin                      └─ guacamole
#
# Guacamole runs with HTTP_AUTH_ENABLED=true (HEADER_AUTH=true in .env), so it
# does not show a login form as long as the proxy sends X-Guac-User. The value
# must be a user that already exists in the Guacamole database with the
# connections granted - here that is "guacadmin".
#
# WHY X-Guac-User AND NOT REMOTE_USER: guacamole-auth-header defaults to
# REMOTE_USER, but an underscore is not carried verbatim by every hop. Measured:
# a request straight to the webapp with REMOTE_USER authenticated (200 + token),
# the same request through Caddy answered 403 - Go canonicalises REMOTE_USER to
# Remote_user on the way through. A dashed name survives nginx, Caddy and Envoy.
# (The property lives in guacamole.properties: http-auth-header: X-Guac-User)
#
# SECURITY MODEL, read before deploying: header auth trusts the header, so the
# webapp must not be reachable except through this proxy. Anything that can talk
# to nuc12:8443 directly can send X-Guac-User and skip Authelia entirely
# (measured: a made-up user gets a token but zero connections; "guacadmin" gets
# the VM). Pick one:
#   a) firewall nuc12 so only the wireguard peer / router can reach 8443
#   b) drop Caddy from this path and use an ssh tunnel from here to nuc12:
#        ssh -N -L 8081:127.0.0.1:8081 yusiwen@192.168.2.48
#      then upstream is http://127.0.0.1:8081 and nothing is exposed at all.

# WebSocket upgrade for /guacamole/websocket-tunnel. Must live in http {} context,
# which is where conf.d/*.conf is included.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen      80;
    listen      [::]:80;
    server_name vm-win11.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;                      # nginx < 1.25.1: use "listen 443 ssl http2;"
    server_name vm-win11.example.com;

    ssl_certificate     /etc/letsencrypt/live/vm-win11.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vm-win11.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Guacamole's file transfer ("drive") uploads through a normal POST body.
    client_max_body_size 512m;

    # ── Authelia ────────────────────────────────────────────────────────────
    # Authelia >= 4.38 (the /api/authz/auth-request endpoint).
    # On 4.37 or older use instead:
    #     set $upstream_authelia http://127.0.0.1:9091/api/verify?rd=https://auth.example.com/;
    #     proxy_pass $upstream_authelia$is_args$args;
    # and redirect with $upstream_http_x_target_url instead of $target_url below.
    location = /authelia {
        internal;
        proxy_pass              http://127.0.0.1:9091/api/authz/auth-request;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        X-Original-URL     $scheme://$http_host$request_uri;
        proxy_set_header        X-Original-Method  $request_method;
        proxy_set_header        X-Forwarded-Method $request_method;
        proxy_set_header        X-Forwarded-Proto  $scheme;
        proxy_set_header        X-Forwarded-Host   $http_host;
        proxy_set_header        X-Forwarded-Uri    $request_uri;
        proxy_set_header        X-Forwarded-For    $remote_addr;
    }

    # Bare domain: Guacamole lives under /guacamole/.
    location = / {
        return 302 /guacamole/;
    }

    # Guacamole's own logout is useless under header auth - the next request is
    # re-authenticated instantly. Send the user to the identity provider instead.
    location = /logout {
        return 302 https://auth.example.com/logout;
    }

    location /guacamole/ {
        auth_request     /authelia;

        # Where to send an unauthenticated visitor, and the refreshed session
        # cookie Authelia returns on success (keeps the 2FA session alive).
        auth_request_set $target_url  $scheme://$http_host$request_uri;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        error_page 401 =302 https://auth.example.com/?rd=$target_url;
        add_header   Set-Cookie $auth_cookie;

        # Who Guacamole should consider logged in. Fixed on purpose: nginx
        # overwrites whatever the client sent, so a browser cannot inject its
        # own identity. Point it at a different (existing) Guacamole user only
        # if you really want per-user connections.
        proxy_set_header X-Guac-User "guacadmin";

        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;

        # The RDP tunnel is a long-lived WebSocket; buffering it breaks it.
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout      3600s;
        proxy_send_timeout      3600s;

        # Option A: nuc12's Caddy. It serves a private-CA certificate with an IP
        # SAN and default_sni set, so an IP-based upstream with no SNI works.
        proxy_pass           https://192.168.2.48:8443/guacamole/;
        proxy_ssl_server_name off;
        proxy_ssl_verify      off;   # or: proxy_ssl_trusted_certificate + on

        # Option B (ssh tunnel, nothing exposed on the LAN): replace the three
        # lines above with
        #     proxy_pass http://127.0.0.1:8081/guacamole/;
    }
}
