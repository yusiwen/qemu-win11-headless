# Copy to .env and fill in.  .env must be chmod 600 - it holds the DB password
# and the Guacamole admin password.
#
# Generate:  printf 'DB_PASSWORD=%s\nADMIN_PASSWORD=%s\n' \
#              "$(openssl rand -hex 16)" "$(openssl rand -hex 16)" >> .env

# Postgres password shared by the guacamole and postgres containers.
DB_PASSWORD=

# Password for the Guacamole web login (user: guacadmin). Changed from the
# factory default by bin/guac-setup.py on first run.
ADMIN_PASSWORD=

# Host-side web port. 8080 on this box is already taken by osp-app.
WEB_PORT=8081

# Where guacd should find the guest RDP endpoint.
#   host.docker.internal -> docker0 (172.17.0.1) -> QEMU hostfwd 0.0.0.0:13389
# If you later bind the forward back to 127.0.0.1, switch guacd to
# network_mode: host and use 127.0.0.1 here instead.
RDP_HOST=host.docker.internal
RDP_PORT=13389

# Set to true only when a trusted reverse proxy in front sets REMOTE_USER
# (see README section 7.4). Anything that can reach the webapp directly could
# otherwise spoof the header and skip authentication.
HEADER_AUTH=false

# Guest account: the user RDP logs in as.
#   - Microsoft account: put your Microsoft account email here, plain - no
#     "MicrosoftAccount\" prefix, which fails to resolve on a locally-linked
#     account (0xC0000064).
#   - Local account: put the local user name.
# The password is deliberately NOT stored: leaving it blank makes the browser
# prompt for it on every connect.
RDP_USER=you@example.com
